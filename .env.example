POSTGRES_DB=jobintel
POSTGRES_USER=jobintel
POSTGRES_PASSWORD=jobintel
DATABASE_URL=postgresql+psycopg://jobintel:jobintel@db:5432/jobintel
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
USE_OLLAMA=true
VITE_API_URL=http://localhost:8100


# Gmail application tracking (Google Cloud OAuth 2.0 Web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8100/api/gmail/callback

# Optional public-web contact discovery (Brave Search API). Leave blank for
# free Gmail + job-posting discovery. External account/key needed if enabled.
# Brave may require billing details despite monthly search credits.
BRAVE_SEARCH_API_KEY=

# Optional automated public-web contact search. Gmail contact finding works
# without this. A Brave account/key may require billing details.
BRAVE_SEARCH_API_KEY=
